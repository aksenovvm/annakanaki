// Модель данных барбершопа (docs/spec.md, раздел 5).
//
// Соглашения:
// - модели в коде называются PascalCase (Barber), таблицы в БД — snake_case (barbers): см. @@map / @map;
// - id — UUID, генерирует сама PostgreSQL (gen_random_uuid), поэтому вставки работают и из обычного SQL;
// - все моменты времени — timestamptz (хранятся в UTC), показываем в Asia/Tashkent;
// - цены — целые суммы в сумах;
// - дни недели — ISO: 1 = понедельник … 7 = воскресенье.
//
// Строка подключения задаётся не здесь, а в prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Справочники ----------

model Service {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String  @default("")
  durationMin Int     @map("duration_min")
  /// Цена в сумах
  price       Int
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  barberServices  BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

model Barber {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  /// Должность на карточке: «Топ-барбер», «Барбер»…
  role            String  @default("Барбер")
  photoUrl        String? @map("photo_url")
  bio             String  @default("")
  experienceYears Int     @default(0) @map("experience_years")
  /// Короткие метки на карточке: «Фейд», «Борода»…
  specialties     String[] @default([])
  /// Telegram chat id — строкой, потому что число не помещается в обычный int
  telegramChatId  String? @map("telegram_chat_id")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  portfolio    PortfolioItem[]
  services     BarberService[]
  workingHours WorkingHours[]
  breaks       Break[]
  timeOff      TimeOff[]
  bookings     Booking[]
  reviews      Review[]

  @@map("barbers")
}

model PortfolioItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String @map("barber_id") @db.Uuid
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("portfolio_items")
}

/// Какие услуги делает мастер. Цену и длительность можно переопределить для конкретного мастера.
model BarberService {
  barberId    String  @map("barber_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  /// null — берём длительность из services
  durationMin Int?    @map("duration_min")
  /// null — берём цену из services
  price       Int?
  isEnabled   Boolean @default(true) @map("is_enabled")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
  @@map("barber_services")
}

// ---------- Расписание ----------

/// Рабочие часы мастера в конкретный день недели. Нет строки — выходной.
model WorkingHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  /// 1 = пн … 7 = вс
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
  @@map("working_hours")
}

/// Регулярный перерыв (обед) в конкретный день недели.
model Break {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("breaks")
}

enum TimeOffType {
  day_off
  vacation
  sick_leave
  closed
  other

  @@map("time_off_type")
}

/// Разовое исключение: отпуск, больничный, выходной. barberId = null — закрыт весь барбершоп.
model TimeOff {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId String?     @map("barber_id") @db.Uuid
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)
  type     TimeOffType @default(other)
  note     String      @default("")

  barber Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
  @@map("time_off")
}

// ---------- Клиенты и записи ----------

model Client {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  /// В формате +998901234567. Может быть пустым у клиента из Telegram.
  phone          String?
  telegramId     String?  @unique @map("telegram_id")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookings Booking[]
  reviews  Review[]

  @@index([phone])
  @@map("clients")
}

enum BookingStatus {
  confirmed
  completed
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  web
  telegram
  admin

  @@map("booking_source")
}

model Booking {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String        @map("client_id") @db.Uuid
  barberId         String        @map("barber_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(3)
  totalPrice       Int           @map("total_price")
  totalDurationMin Int           @map("total_duration_min")
  status           BookingStatus @default(confirmed)
  source           BookingSource
  /// Длинный случайный токен для ссылки /booking/[token]
  manageToken      String        @unique @map("manage_token")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  /// [starts_at, ends_at) одним диапазоном. Считается самой базой (GENERATED), руками не заполняется.
  /// Нужен для ограничения bookings_no_overlap — см. миграцию *_booking_no_overlap.
  timeRange Unsupported("tstzrange")? @default(dbgenerated("tstzrange(starts_at, ends_at, '[)'::text)")) @map("time_range")

  // Отметки фоновых задач (этап 8) — защищают от повторной отправки
  reminderDaySentAt DateTime? @map("reminder_day_sent_at") @db.Timestamptz(3)
  reminder30mSentAt DateTime? @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reviewRequestedAt DateTime? @map("review_requested_at") @db.Timestamptz(3)
  autoCompletedAt   DateTime? @map("auto_completed_at") @db.Timestamptz(3)

  client   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barber   Barber           @relation(fields: [barberId], references: [id], onDelete: Restrict)
  services BookingService[]
  review   Review?

  @@index([barberId, startsAt])
  @@index([clientId])
  @@index([status, startsAt])
  @@map("bookings")
}

/// Снимок услуги на момент записи: если потом поменяют цену, старая запись не изменится.
model BookingService {
  bookingId   String @map("booking_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid
  name        String
  durationMin Int    @map("duration_min")
  price       Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_services")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// 1–5
  rating    Int      @db.SmallInt
  comment   String   @default("")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@index([isPublic, createdAt])
  @@map("reviews")
}

// ---------- Система ----------

/// Настройки «ключ → значение»: cancel_cutoff_min = 30, timezone = "Asia/Tashkent"…
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model AdminUser {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login          String  @unique
  /// Только Argon2-хеш, никогда не сам пароль
  passwordHash   String  @map("password_hash")
  telegramChatId String? @map("telegram_chat_id")

  @@map("admin_users")
}
