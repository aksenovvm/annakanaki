# Скопируйте в .env.local (этот файл не попадает в git).

# Только для разработки в обычном браузере (без Telegram):
# подписанная тестовая строка initData. Получить: npm run tg:dev-init-data
VITE_DEV_INIT_DATA=""

# Адрес API. В разработке оставьте пустым — запросы идут через Vite-прокси на localhost:4000.
# При деплое (этап 11) — адрес задеплоенного API.
VITE_API_URL=""
