# Скопируйте этот файл в .env (в этой же папке apps/api) и заполните.
# Файл .env не попадает в git.

# Та же строка, что DATABASE_URL в packages/db/.env (пулер Supabase, порт 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Порт сервера
PORT=4000

# С каких сайтов браузеру можно обращаться к API (через запятую)
CORS_ORIGINS="http://localhost:3000"
