# Необязательно для разработки: по умолчанию сайт ищет API на http://localhost:4000
# Понадобится при деплое (этап 11) — адрес задеплоенного API.

# Адрес API для запросов с сервера Next.js (главная, страница записи)
API_URL="http://localhost:4000"

# Адрес API для запросов из браузера (свободное время, запись, отмена).
# Префикс NEXT_PUBLIC_ означает «попадёт в код для браузера» — сюда только несекретное.
NEXT_PUBLIC_API_URL="http://localhost:4000"
