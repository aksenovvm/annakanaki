{
  "name": "barbershop",
  "private": true,
  "version": "0.1.0",
  "description": "Учебная система автоматизации барбершопа",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@barbershop/web",
    "build": "npm run build --workspace=@barbershop/web",
    "start": "npm run start --workspace=@barbershop/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
